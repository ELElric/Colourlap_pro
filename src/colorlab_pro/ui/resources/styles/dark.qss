/* ColorLab Pro Dark Theme — No Sidebar Layout */

QMainWindow {
    background-color: #1c1c1e;
}

QWidget {
    background-color: #1c1c1e;
    color: #f5f5f7;
    font-family: "Segoe UI", "Microsoft YaHei UI", "PingFang SC", Arial, sans-serif;
    font-size: 14px;
}

/* Menu Bar */
QMenuBar {
    background-color: #1c1c1e;
    border-bottom: 1px solid #38383a;
    color: #a1a1a6;
    padding: 4px;
}

QMenuBar::item {
    background-color: transparent;
    padding: 6px 10px;
    border-radius: 6px;
}

QMenuBar::item:selected {
    background-color: #3a3a3c;
    color: #f5f5f7;
}

QMenu {
    background-color: #2c2c2e;
    border: 1px solid #48484a;
    padding: 4px;
}

QMenu::item {
    padding: 6px 24px;
    border-radius: 6px;
}

QMenu::item:selected {
    background-color: #0a84ff;
    color: white;
}

/* Status Bar */
QStatusBar {
    background-color: #1c1c1e;
    color: #8e8e93;
    border-top: 1px solid #38383a;
    font-size: 12px;
}

/* Sidebar Navigation */
#Sidebar {
    background-color: #1c1c1e;
    border-right: 1px solid #38383a;
}

#Sidebar QPushButton#nav-item {
    background-color: transparent;
    color: #a1a1a6;
    border: none;
    border-left: 3px solid transparent;
    text-align: left;
    padding: 0 16px;
    height: 40px;
    font-size: 14px;
    font-weight: 400;
    border-radius: 0;
}

#Sidebar QPushButton#nav-item:hover {
    background-color: #3a3a3c;
    color: #f5f5f7;
}

#Sidebar QPushButton#nav-item[active="true"] {
    background-color: rgba(10, 132, 255, 0.14);
    color: #ffffff;
    border-left-color: #0a84ff;
}

/* Tab Bar (kept for in-page tabs) */
QTabBar {
    background: #1c1c1e;
    border-bottom: 1px solid #38383a;
}

QTabBar::tab {
    background-color: transparent;
    color: #a1a1a6;
    border: none;
    border-radius: 10px;
    padding: 0 14px;
    height: 34px;
    margin: 0 2px;
}

QTabBar::tab:selected {
    background-color: rgba(10, 132, 255, 0.14);
    color: #ffffff;
    border: 1px solid rgba(10, 132, 255, 0.42);
}

QTabBar::tab:hover:!selected {
    background-color: #3a3a3c;
    color: #f5f5f7;
}

/* Buttons */
QPushButton {
    background-color: #3a3a3c;
    color: #f5f5f7;
    border: 1px solid #48484a;
    border-radius: 6px;
    padding: 0 13px;
    height: 34px;
    font-weight: 650;
}

QPushButton:hover {
    background-color: #48484a;
}

QPushButton:pressed {
    background-color: #0a84ff;
}

QPushButton:disabled {
    opacity: 0.45;
    background-color: #3a3a3c;
    color: #8e8e93;
}

/* Primary Button */
QPushButton[primary="true"] {
    background-color: #0a84ff;
    border-color: #0a84ff;
    color: white;
}

QPushButton[primary="true"]:hover {
    background-color: #409cff;
    border-color: #409cff;
}

/* Secondary Button */
QPushButton.secondary {
    background-color: transparent;
    color: #a1a1a6;
    border: 1px solid #48484a;
}

QPushButton.secondary:hover {
    background-color: #3a3a3c;
    color: #f5f5f7;
}

/* Danger Button */
QPushButton.danger {
    background-color: rgba(229, 83, 83, 0.12);
    border-color: rgba(229, 83, 83, 0.36);
    color: #ff9a9a;
}

/* Labels */
QLabel {
    color: #f5f5f7;
}

QLabel.title {
    font-size: 24px;
    font-weight: 700;
    color: #f5f5f7;
    letter-spacing: -0.02em;
}

QLabel.subtitle {
    font-size: 13px;
    color: #a1a1a6;
}

/* Top Bar */
#brand {
    font-weight: 700;
    font-size: 15px;
    letter-spacing: 0.2px;
}

#status-dot {
    background: #3ddc84;
    border-radius: 4px;
}

#status-label {
    font-size: 13px;
}

#status-pill {
    border: 1px solid #48484a;
    border-radius: 999px;
    padding: 0 12px;
    background: #2c2c2e;
}

/* Line Edit */
QLineEdit {
    background-color: #3a3a3c;
    border: 1px solid #48484a;
    border-radius: 6px;
    padding: 0 10px;
    height: 34px;
    color: #f5f5f7;
}

QLineEdit:focus {
    border-color: rgba(10, 132, 255, 0.72);
    box-shadow: 0 0 0 3px rgba(10, 132, 255, 0.12);
}

/* Text Edit */
QTextEdit, QPlainTextEdit {
    background-color: #2c2c2e;
    border: 1px solid #48484a;
    border-radius: 6px;
    padding: 8px;
    color: #f5f5f7;
}

/* List Widget */
QListWidget {
    background-color: #2c2c2e;
    border: 1px solid #38383a;
    border-radius: 10px;
    outline: none;
}

QListWidget::item {
    padding: 8px 12px;
    border-radius: 6px;
}

QListWidget::item:selected {
    background-color: rgba(10, 132, 255, 0.14);
    color: #ffffff;
}

QListWidget::item:hover {
    background-color: #3a3a3c;
}

/* Combo Box */
QComboBox {
    background-color: #3a3a3c;
    border: 1px solid #48484a;
    border-radius: 6px;
    padding: 0 10px;
    height: 34px;
    color: #f5f5f7;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox QAbstractItemView {
    background-color: #2c2c2e;
    border: 1px solid #48484a;
    selection-background-color: rgba(10, 132, 255, 0.14);
    selection-color: #ffffff;
}

/* Scroll Bar */
QScrollBar:vertical {
    background-color: #1c1c1e;
    width: 10px;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background-color: #48484a;
    border-radius: 5px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background-color: #636366;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: #1c1c1e;
    height: 10px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal {
    background-color: #48484a;
    border-radius: 5px;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #636366;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* Group Box */
QGroupBox {
    border: 1px solid #38383a;
    border-radius: 10px;
    margin-top: 12px;
    padding-top: 12px;
    font-weight: 700;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
    color: #a1a1a6;
}

/* Table */
QTableWidget {
    background-color: #2c2c2e;
    border: 1px solid #38383a;
    border-radius: 10px;
    gridline-color: #38383a;
}

QComboBox#table-combo {
}

QTableWidget::item {
    padding: 14px 12px;
}

QTableWidget::item:selected {
    background-color: rgba(10, 132, 255, 0.14);
    color: #ffffff;
}

QHeaderView::section {
    background-color: #2c2c2e;
    color: #a1a1a6;
    border: 1px solid #38383a;
    padding: 10px 12px;
    font-weight: 700;
}

/* Splitter */
QSplitter::handle {
    background-color: #48484a;
}

QSplitter::handle:horizontal {
    width: 2px;
}

QSplitter::handle:vertical {
    height: 2px;
}

/* Progress Bar */
QProgressBar {
    border: 1px solid #38383a;
    border-radius: 10px;
    text-align: center;
    background-color: #2c2c2e;
}

QProgressBar::chunk {
    background-color: #0a84ff;
    border-radius: 10px;
}

/* Tool Tip */
QToolTip {
    background-color: #2c2c2e;
    color: #f5f5f7;
    border: 1px solid #48484a;
    border-radius: 6px;
    padding: 6px;
}
